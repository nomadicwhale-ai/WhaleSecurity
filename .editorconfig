root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Attack fixtures are byte-exact (quality-and-release §2.1).
[{tests/fixtures,tests/golden,tests/hooks/cases,evals/injection-corpus,evals/smoke}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
